rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isMember(outingId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/outings/$(outingId)/members/$(request.auth.uid));
    }
    
    function isHost(outingId) {
      return isSignedIn() && 
        get(/databases/$(database)/documents/outings/$(outingId)).data.hostId == request.auth.uid;
    }
    
    function isChatExpired(outingId) {
      let outing = get(/databases/$(database)/documents/outings/$(outingId));
      let expiresAt = outing.data.chatExpiresAt;
      return expiresAt != null && request.time > expiresAt;
    }

    function isBlocked(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + "_" + b));
    }

    function isDirectChatParticipant(chatId) {
      return exists(/databases/$(database)/documents/directChats/$(chatId)) &&
        get(/databases/$(database)/documents/directChats/$(chatId)).data.participants.hasAny([uid()]);
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow create: if isSignedIn();
      }
      
      // Active outings index
      match /activeOutings/{outingId} {
        allow read, write: if isOwner(userId);
      }

      // Optional: per-user connections
      match /connections/{otherId} {
        allow read, write: if isOwner(userId);
      }

      match /usage/{usageId} {
        allow read, write: if isOwner(userId);
      }

      // Optional: per-user past outings index
      match /pastOutings/{outingId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Outings collection
    match /outings/{outingId} {
      // Anyone can read active outings
      allow read: if isSignedIn() && resource.data.status == "active";
      
      // Only hosts can create (enforced in code, but rule as backup)
      allow create: if isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isHost == true;
      
      // Host can update their outing (including status, manualReveal, etc.)
      allow update: if isHost(outingId) &&
        // Ensure status transitions are valid
        (request.resource.data.status == resource.data.status ||
         request.resource.data.status in ["active", "cancelled", "ended"]);
      
      // Members subcollection
      match /members/{memberId} {
        // Members can read who's in the outing
        allow read: if isSignedIn() && isMember(outingId);
        
        // Allow member creation if:
        // 1. Host is adding (curated approval) OR
        // 2. User is adding themselves AND event is fast mode AND not full
        allow create: if isSignedIn() && (
          // Host can always add members
          isHost(outingId) ||
          // User can add themselves if fast mode and not full
          (memberId == request.auth.uid &&
           get(/databases/$(database)/documents/outings/$(outingId)).data.eventMode == "fast" &&
           get(/databases/$(database)/documents/outings/$(outingId)).data.approvedCount < 
           get(/databases/$(database)/documents/outings/$(outingId)).data.maxGuests &&
           request.resource.data.role == "member" &&
           request.resource.data.joinedAt == request.time)
        );
        
        // Members can update their own RSVP, host can update/delete any member
        allow update: if isSignedIn() && (
          // Member updating their own RSVP
          (memberId == request.auth.uid &&
           request.resource.data.rsvp is string &&
           request.resource.data.rsvp in ["going", "maybe", "no"] &&
           request.resource.data.role == resource.data.role &&
           request.resource.data.joinedAt == resource.data.joinedAt) ||
          // Host updating any member
          isHost(outingId)
        );
        
        // Members can delete themselves (leave), host can delete any member
        allow delete: if isSignedIn() && (
          memberId == request.auth.uid ||
          isHost(outingId)
        );
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only members can read messages
        allow read: if isMember(outingId);
        
        // Members can create user messages, system messages can be created by members (for host actions)
        allow create: if isMember(outingId) &&
          !isChatExpired(outingId) &&
          (
            // User message
            (request.resource.data.type == "user" &&
             request.resource.data.senderId == request.auth.uid &&
             request.resource.data.text is string &&
             request.resource.data.text.size() > 0 &&
             request.resource.data.text.size() <= 1000 &&
             request.resource.data.createdAt == request.time) ||
            // System message (created by host or during transactions)
            (request.resource.data.type == "system" &&
             request.resource.data.text is string &&
             request.resource.data.text.size() > 0 &&
             request.resource.data.text.size() <= 500 &&
             request.resource.data.createdAt == request.time)
          );
        
        // No updates or deletes
        allow update, delete: if false;
      }
      
      // Chat meta
      match /chatMeta/{docId} {
        allow read: if isMember(outingId);
        allow write: if isMember(outingId);
      }
      
      // Phase 2: Waitlist subcollection
      match /waitlist/{userId} {
        allow read: if isSignedIn() && (isHost(outingId) || userId == request.auth.uid);
        allow create: if isSignedIn() && userId == request.auth.uid;
        allow delete: if isSignedIn() && (isHost(outingId) || userId == request.auth.uid);
        allow update: if false;
      }
    }
    
    // Outing requests collection
    match /outingRequests/{requestId} {
      // Users can read their own requests
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || resource.data.hostId == request.auth.uid);
      
      // Users can create their own requests
      // For curated: status must be "pending"
      // For fast: status can be "approved" (auto-approve)
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        (
          // Curated request
          (request.resource.data.status == "pending" && 
           request.resource.data.source == "curated_request") ||
          // Fast join (auto-approved)
          (request.resource.data.status == "approved" && 
           request.resource.data.source == "fast_join" &&
           get(/databases/$(database)/documents/outings/$(request.resource.data.outingId)).data.eventMode == "fast")
        );
      
      // Only host can update (approve/decline)
      allow update: if isSignedIn() &&
        resource.data.hostId == request.auth.uid &&
        request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.outingId == resource.data.outingId;
      
      // No deletes
      allow delete: if false;
    }

    // Blocks
    match /blocks/{blockId} {
      allow read: if false;
      allow create: if isSignedIn() &&
        request.resource.data.blockerUid == uid() &&
        request.resource.data.blockedUid is string;
      allow delete: if isSignedIn() &&
        resource.data.blockerUid == uid();
      allow update: if false;
    }

    // Connection requests
    match /connectionRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == uid() || resource.data.toUid == uid());

      allow create: if isSignedIn() &&
        request.resource.data.fromUid == uid() &&
        request.resource.data.toUid is string &&
        request.resource.data.status == "pending" &&
        request.resource.data.expiresAt > request.time &&
        !isBlocked(uid(), request.resource.data.toUid) &&
        !isBlocked(request.resource.data.toUid, uid());

      allow update: if isSignedIn() &&
        resource.data.status == "pending" &&
        resource.data.toUid == uid() &&
        (request.resource.data.status in ["accepted", "rejected", "expired"]) &&
        (request.resource.data.status != "accepted" || request.time <= resource.data.expiresAt);

      allow update: if isSignedIn() &&
        resource.data.status == "pending" &&
        resource.data.fromUid == uid() &&
        request.resource.data.status == "cancelled";

      allow delete: if false;
    }

    // Direct chats
    match /directChats/{chatId} {
      allow read: if isSignedIn() &&
        resource.data.participants.hasAny([uid()]);

      allow create: if isSignedIn() &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants.hasAny([uid()]);

      allow update: if isSignedIn() &&
        resource.data.participants.hasAny([uid()]);

      match /messages/{messageId} {
        allow read: if isSignedIn() && isDirectChatParticipant(chatId);
        allow create: if isSignedIn() &&
          isDirectChatParticipant(chatId) &&
          request.time < get(/databases/$(database)/documents/directChats/$(chatId)).data.expiresAt &&
          (
            (request.resource.data.type == "system" && request.resource.data.senderUid == null) ||
            (request.resource.data.type == "user" && request.resource.data.senderUid == uid())
          );
        allow update, delete: if false;
      }

      match /saveIntent/{intentUid} {
        allow read: if isSignedIn() && isDirectChatParticipant(chatId);
        allow create: if isSignedIn() &&
          intentUid == uid() &&
          isDirectChatParticipant(chatId);
        allow update, delete: if false;
      }

      // Phase 3: Chat meta for typing indicators and read receipts
      match /meta/{docId} {
        allow read, write: if isSignedIn() && isDirectChatParticipant(chatId);
      }
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == uid();
      allow read, update, delete: if false;
    }
  }
}
